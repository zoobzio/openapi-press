{
  "name": "openapi-press",
  "version": "0.1.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zoobzio/openapi-press.git",
    "directory": "packages/openapi-press"
  },
  "type": "module",
  "main": "./.dist/index.mjs",
  "types": "./.dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./.dist/index.d.ts",
      "import": "./.dist/index.mjs"
    },
    "./error": {
      "types": "./.dist/error.d.ts",
      "import": "./.dist/error.mjs"
    }
  },
  "files": [
    ".dist"
  ],
  "scripts": {
    "build": "unbuild",
    "stub": "unbuild --stub",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@openapi-press/call": "workspace:*",
    "@openapi-press/client": "workspace:*",
    "@openapi-press/error": "workspace:*",
    "@openapi-press/spec": "workspace:*"
  }
}
