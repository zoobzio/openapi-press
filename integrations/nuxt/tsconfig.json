{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "@nuxt/nitro-server"],
    "paths": {
      "@openapi-press/nuxt/constant": ["./src/constant.ts"],
      "@openapi-press/nuxt/types": ["./src/types.ts"],
      "@openapi-press/nuxt/util": ["./src/util.ts"],
      "#imports": ["./src/stubs/imports.d.ts"],
      "#build/openapi-press.mjs": ["./src/stubs/build/openapi-press.d.mts"],
      "#build/types/openapi-press": [
        "./src/stubs/build/types/openapi-press.d.ts"
      ]
    }
  },
  "include": ["src", "test"]
}
